{
  "name": "ai-capsule",
  "version": "1.0.0",
  "description": "AI Capsule - Cloud-Deployed AI Prompt Manager (React + Node/Express + SQLite + GitHub OAuth + JWT)",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "install:client": "npm install --prefix client",
    "build": "npm run install:client && npm run build --prefix client",
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --prefix client",
    "test": "node server/test/api.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
