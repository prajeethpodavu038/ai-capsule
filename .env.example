# Copy this file to .env for local development and fill in real values.
# Never commit the real .env file.

# Port the Express server listens on
PORT=4000

# Set to "production" on the deployed cloud platform.
# Controls the Secure flag on the JWT cookie (secure cookies require HTTPS).
NODE_ENV=development

# Secret used to sign/verify the application JWT (jsonwebtoken).
# Use a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=replace-with-a-long-random-string

# GitHub OAuth App credentials.
# Create at: https://github.com/settings/developers -> "New OAuth App"
GITHUB_CLIENT_ID=replace-with-your-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-oauth-client-secret

# Must exactly match the "Authorization callback URL" configured on the GitHub OAuth App.
# Local:      http://localhost:4000/auth/github/callback
# Deployed:   https://YOUR-APP.onrender.com/auth/github/callback
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback

# Base URL of this app itself (used to build the OAuth redirect and for CORS-free same-origin serving).
# Local:      http://localhost:4000
# Deployed:   https://YOUR-APP.onrender.com
APP_BASE_URL=http://localhost:4000

# Path to the SQLite database file.
# On Render's free tier this is on ephemeral local disk (see README "Storage" section).
DB_PATH=./data/ai_capsule.sqlite3
